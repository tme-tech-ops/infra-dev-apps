            password: {{ nodered_admin_hash | to_json }},
            permissions: '*'
        }]
    },

    // Basic auth for the HTTP-in endpoints (/api/fault, /api/status).
    httpNodeAuth: {
        user: {{ admin_username | to_json }},
        pass: {{ nodered_admin_hash | to_json }}
    },

    // The InfluxDB token is read from the compose secret, never from flows.json.
