      "title": "Throughput (parts / min)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iot"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"machine_telemetry\" and r._field == \"parts_total\")\n  |> group(columns: [\"machine\"])\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n  |> derivative(unit: 1m, nonNegative: true)\n  |> keep(columns: [\"_time\", \"_value\", \"machine\"])"
